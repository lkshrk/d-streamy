	license = BSD-2-Clause
	license = BSD-3-Clause
	license = BSL-1.0
	license = CDLA-Permissive-2.0
	license = ISC
	license = MIT
	license = MPL-2.0
	license = Unicode-3.0
	license = Unlicense
	license = Zlib
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gst-plugin-pipewire
	depends = gst-plugins-bad-libs
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gst-plugins-ugly
	depends = gstreamer
