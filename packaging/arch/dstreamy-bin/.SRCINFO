pkgbase = dstreamy-bin
	pkgdesc = Stream a window, a display or OBS's output to Discord Go Live
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/lkshrk/d-streamy
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	license = 0BSD
	license = Apache-2.0
