{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>lkshrk/gh-ops//renovate/presets/app-library.json5",
    "github>lkshrk/gh-ops//renovate/presets/automerge-major.json5",
    "helpers:pinGitHubActionDigests",
  ],
  // GitHub auto-merge waits only for required checks, and path-filtered OBS can't be one.
  platformAutomerge: false,
  packageRules: [
    {
      // Patched through [patch.crates-io] in rust/Cargo.toml; a newer requirement would silently drop the patch.
      matchManagers: ["cargo"],
      matchPackageNames: ["webrtc"],
      enabled: false,
    },
    {
      // The remaining 24.04 jobs match the release builds' glibc floor and OBS baseline; move them by hand.
      matchManagers: ["github-actions"],
      matchDepNames: ["ubuntu"],
      enabled: false,
    },
  ],
}
